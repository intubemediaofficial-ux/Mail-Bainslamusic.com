# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Run: openssl rand -hex 32
NEXTAUTH_SECRET="change-me"
# Public URL of the site (used by next-auth)
NEXTAUTH_URL="http://localhost:3000"

# Initial admin login created by `npm run db:seed` (change password from /admin/account after login)
ADMIN_EMAIL="admin@kvspt.com"
ADMIN_PASSWORD="change-me"

# Optional: forward contact form enquiries by email via Resend (enquiries are always saved in the admin panel)
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL="info@kvspt.com"
# CONTACT_FROM_EMAIL="KVSPT Website <noreply@kvspt.com>"
